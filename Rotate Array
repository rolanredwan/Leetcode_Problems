public class Solution
{
    public void Rotate(int[] nums, int k)
    {
        int n = nums.Length;
        k = k % n;
        int[] end = new int[k];
        for (int i = 0; i < k; i++)
        {
            end[i] = nums[n - k + i];
        }
        for (int i = n - 1; i >= k; i--)
        {
            nums[i] = nums[i - k];
        }
        for (int i = 0; i < k; i++)
        {
            nums[i] = end[i];
        }
    }
}
